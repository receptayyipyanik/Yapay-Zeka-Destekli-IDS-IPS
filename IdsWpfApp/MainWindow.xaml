<Window x:Class="IdsWpfApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Modern IDS/IPS Arayuzu" Height="650" Width="1050"
        Background="#0F172A"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E2E8F0"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Border" x:Key="CardStyle">
            <Setter Property="Background" Value="#1E293B"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="10"/>
        </Style>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Grid.ColumnSpan="2" Style="{StaticResource CardStyle}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="SIBER GUVENLIK MERKEZI" FontSize="26" FontWeight="Bold" Foreground="#38BDF8"/>
                <TextBlock x:Name="StatusText" Text=" - Baslatiliyor..." FontSize="16" Foreground="#94A3B8" VerticalAlignment="Center" Margin="15,0,0,0"/>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="1" Grid.Column="0">
            <Border Style="{StaticResource CardStyle}" Height="160">
                <StackPanel>
                    <TextBlock Text="TRAFIK OZETI" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="#94A3B8"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Toplam Paket:" FontSize="16"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" x:Name="TotalPacketsText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#34D399" HorizontalAlignment="Right"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Anormal Paket:" FontSize="16" Margin="0,15,0,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AnomalousPacketsText" Text="0" FontSize="22" FontWeight="Bold" Foreground="#F43F5E" HorizontalAlignment="Right" Margin="0,15,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Height="300">
                <StackPanel>
                    <TextBlock Text="SISTEM DURUMU" FontSize="18" FontWeight="Bold" Margin="0,0,0,20" Foreground="#94A3B8"/>
                    <TextBlock Text="Guncel Tehdit Durumu:" FontSize="16" Margin="0,5"/>
                    <TextBlock Text="Guvende" x:Name="SystemStateText" FontSize="28" FontWeight="Bold" Foreground="#34D399"/>
                </StackPanel>
            </Border>
        </StackPanel>
        <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="CANLI ALARMLAR VE SALDIRGAN IP'LER" FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Foreground="#94A3B8"/>
                <ListBox Grid.Row="1" x:Name="AlertList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#33F43F5E" CornerRadius="8" Padding="15" Margin="0,0,0,10" Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding IpAddress}" FontSize="20" FontWeight="Bold" Foreground="#F43F5E"/>
                                        <TextBlock Text="{Binding Details}" FontSize="14" Foreground="#E2E8F0" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="IP ENGELLE" Width="110" Height="40" Background="#F43F5E" Foreground="White" FontWeight="Bold" BorderThickness="0" CommandParameter="{Binding IpAddress}" Click="BlockIp_Click" Cursor="Hand">
                                        <Button.Resources>
                                            <Style TargetType="Border">
                                                <Setter Property="CornerRadius" Value="5"/>
                                            </Style>
                                        </Button.Resources>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</Window>
